# ── Copy this file to .streamlit/secrets.toml and fill in real values ──────────
# On Streamlit Cloud, add these as Secrets in the app dashboard instead
# (Settings → Secrets).  Never commit a filled-in secrets.toml to git.

# ── LLM — Groq (REQUIRED) ─────────────────────────────────────────────────────
# Free key at https://console.groq.com/keys  (sign in with GitHub, no credit card)
GROQ_API_KEY = "gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
GROQ_MODEL   = "qwen/qwen3-27b"

# Optional: rotate through these models when the primary is rate-limited
# GROQ_FALLBACK_MODELS = "openai/gpt-oss-20b,openai/gpt-oss-120b"

# ── LLM — Gemini (optional fallback) ──────────────────────────────────────────
# Free key at https://aistudio.google.com/app/apikey
# Leave blank to disable Gemini.
GEMINI_API_KEY = ""
GEMINI_MODEL   = "gemini-2.5-flash"

# ── Auth (REQUIRED) ────────────────────────────────────────────────────────────
# Generate a real key with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# NEVER use the placeholder below in production.
SECRET_KEY = "CHANGE_ME_use_python_secrets_token_hex_32"

# ── Admin seed account ─────────────────────────────────────────────────────────
# The admin user is created automatically on first boot from these values.
# Change ADMIN_SEED_PASSWORD to something strong before deploying.
ADMIN_SEED_EMAIL    = "admin@studybuddy.com"
ADMIN_SEED_PASSWORD = "Admin@StudyBuddy2024"

# ── Email / SMTP (optional — leave blank to disable email features) ────────────
# Gmail example: use an App Password (not your normal password).
SMTP_HOST = ""
SMTP_PORT = "587"
SMTP_USER = ""
SMTP_PASS = ""
SMTP_FROM = "noreply@studybuddy.com"

# ── App base URL (used in email links) ────────────────────────────────────────
# Set this to your Streamlit Cloud app URL after deployment.
APP_BASE_URL = "https://your-app-name.streamlit.app"

# ── Observability (optional) ──────────────────────────────────────────────────
# Sign up at https://sentry.io for a free DSN.
# SENTRY_DSN = ""
