# ── StudyBuddy AI - Environment Configuration Example ──────────────────────
# Copy this file to .env and fill in the values for your deployment.

# ── Environment ─────────────────────────────────────────────────────────────
ENVIRONMENT=development
APP_BASE_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# ── LLM Configuration ────────────────────────────────────────────────────────
# Groq (Primary): https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODELS=llama-3.1-8b-instant

# Google Gemini (Fallback): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ── Security & Authentication ────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate_a_random_32_byte_hex_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=1440
AUTH_REQUIRED=true

# ── 2-Factor OTP Verification ────────────────────────────────────────────────
OTP_AUTH_ENABLED=false
OTP_EXPIRE_MINUTES=5
# Set OTP_SIMULATION_MODE=true only for local offline dev/testing (never in production)
OTP_SIMULATION_MODE=false

# ── Administrator Account Setup ──────────────────────────────────────────────
# Master keys accepted for admin self-registration (comma-separated if multiple)
ADMIN_KEYS=your_admin_registration_setup_key_here
# Initial admin account seeded on first startup (if configured)
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=your_strong_admin_password_here

# ── Database (Production PostgreSQL & Local SQLite) ──────────────────────────
# SQLite: sqlite+aiosqlite:///./studybuddy.db
# PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/studybuddy
DATABASE_URL=sqlite+aiosqlite:///./studybuddy.db

# ── Cloud Object Storage (S3 / Cloudflare R2 / MinIO) ────────────────────────
STORAGE_BACKEND=auto
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_REGION_NAME=auto
S3_PUBLIC_URL=

# ── File Storage & Vector Stores ─────────────────────────────────────────────
UPLOAD_DIR=./uploads
CHROMA_PERSIST_DIR=./chroma_db
FAISS_INDEX_DIR=./faiss_indexes
MAX_FILE_SIZE_MB=200
ASSIGNMENT_FILE_MAX_MB=50
NOTE_FILE_MAX_MB=50
PROFILE_PHOTO_MAX_MB=5

# ── CORS Origins & Rate Limiting ─────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8501,http://127.0.0.1:8501
RATE_LIMIT_PER_MINUTE=60

# ── Real Email Dispatch (SMTP) ───────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_username_or_email
SMTP_PASS=your_smtp_password_or_app_password
SMTP_FROM=StudyBuddy <noreply@example.com>

# ── Observability (Optional) ─────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Academic Defaults ────────────────────────────────────────────────────────
PERIOD_DURATION_MINUTES=45
LUNCH_DURATION_MINUTES=45
