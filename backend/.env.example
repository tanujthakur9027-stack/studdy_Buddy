# ── Copy to .env and fill in real values (never commit .env) ───────────────────

# ── LLM — Groq (primary) ───────────────────────────────────────────────────────
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=qwen/qwen3-27b

# ── LLM — Gemini (fallback — used when Groq is rate-limited) ──────────────────
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-2.5-flash

# ── Auth ────────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_use_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Whether to require a valid JWT on AI endpoints (true = enforce, false = legacy mode)
AUTH_REQUIRED=true

# ── Admin seed account ─────────────────────────────────────────────────────────
ADMIN_SEED_EMAIL=admin@studybuddy.com
ADMIN_SEED_PASSWORD=Admin@StudyBuddy2024   # change in production!

# ── Database ───────────────────────────────────────────────────────────────────
# SQLite (default for local dev):
DATABASE_URL=sqlite+aiosqlite:///./data/studybuddy.db
# Postgres (recommended for production):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/studybuddy

# ── File storage ───────────────────────────────────────────────────────────────
UPLOAD_DIR=./data/uploads
CHROMA_PERSIST_DIR=./data/chroma_db
FAISS_INDEX_DIR=./data/faiss_indexes
MAX_FILE_SIZE_MB=200
ASSIGNMENT_FILE_MAX_MB=50
NOTE_FILE_MAX_MB=50
PROFILE_PHOTO_MAX_MB=5

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (use * only for local dev)
CORS_ORIGINS=http://localhost:3000,http://localhost:8501

# ── Rate limiting ──────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60

# ── Email (optional SMTP — leave blank to disable) ────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@studybuddy.com
APP_BASE_URL=http://localhost:8501

# ── Timetable ──────────────────────────────────────────────────────────────────
PERIOD_DURATION_MINUTES=45
LUNCH_DURATION_MINUTES=45
