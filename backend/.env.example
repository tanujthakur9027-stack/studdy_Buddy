# ── Primary LLM — OpenAI ──────────────────────────────────────────────────────
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...your-openai-key-here...
OPENAI_MODEL=gpt-4o-mini

# ── Fallback LLM — Groq (FREE, no credit card needed) ────────────────────────
# Get your key at https://console.groq.com/keys
# Used automatically when OPENAI_API_KEY is not set
# Recommended model: openai/gpt-oss-20b (fast & capable)
# GROQ_API_KEY=gsk_...your-groq-key-here...
# GROQ_MODEL=openai/gpt-oss-20b

# ── Vector store & file storage ───────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db
FAISS_INDEX_DIR=./faiss_indexes
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=200

# ── Text chunking ─────────────────────────────────────────────────────────────
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# ── CORS — comma-separated list of allowed frontend origins ───────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default for local dev):
DATABASE_URL=sqlite+aiosqlite:///./studybuddy.db
# PostgreSQL (for production):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/studybuddy

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=20

# ── Observability (optional) ──────────────────────────────────────────────────
# Leave blank to disable Sentry; paste your DSN from https://sentry.io to enable
# SENTRY_DSN=https://...@....ingest.sentry.io/...
# SENTRY_TRACES_SAMPLE_RATE=0.1
