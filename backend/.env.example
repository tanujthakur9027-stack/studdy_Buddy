# ── Primary LLM — OpenAI ──────────────────────────────────────────────────────
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...your-openai-key-here...
OPENAI_MODEL=gpt-4o-mini

# ── Fallback LLM — Groq (FREE, no credit card needed) ────────────────────────
# Get your key at https://console.groq.com/keys
# Used automatically when OPENAI_API_KEY is not set
# Recommended model: qwen/qwen3.6-27b (fast & capable)
# GROQ_API_KEY=gsk_...your-groq-key-here...
# GROQ_MODEL=qwen/qwen3.6-27b

# ── Vector store & file storage ───────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db
FAISS_INDEX_DIR=./faiss_indexes
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=20

# ── Text chunking ─────────────────────────────────────────────────────────────
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# ── CORS — comma-separated list of allowed frontend origins ───────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
