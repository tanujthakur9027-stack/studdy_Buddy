# ── StudyBuddy AI - Environment Configuration Example ──────────────────────

# ── LLM Configuration ────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen/qwen3-27b
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ── Security & Authentication ────────────────────────────────────────────────
SECRET_KEY=generate_a_random_32_byte_hex_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=1440
AUTH_REQUIRED=true

# ── 2-Factor OTP Verification ────────────────────────────────────────────────
OTP_AUTH_ENABLED=true
OTP_EXPIRE_MINUTES=5
OTP_SIMULATION_MODE=false

# ── Administrator Account Defaults ───────────────────────────────────────────
ADMIN_SEED_EMAIL=admin@studybuddy.com
ADMIN_SEED_PASSWORD=Admin@StudyBuddy2024

# ── Database (Production PostgreSQL & Local SQLite) ──────────────────────────
# PostgreSQL is the best production database for StudyBuddy with asyncpg connection pooling.
# Quick Setup options:
# 1) Free Cloud Serverless PostgreSQL (Neon.tech):
#    DATABASE_URL=postgresql+asyncpg://username:password@ep-xyz.us-east-2.aws.neon.tech/neondb?ssl=require
# 2) Supabase PostgreSQL:
#    DATABASE_URL=postgresql+asyncpg://postgres.xyz:password@aws-0-region.pooler.supabase.com:6543/postgres?ssl=require
# 3) Local PostgreSQL server:
#    DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/studybuddy
# 4) High-performance persistent SQLite (Local fallback with WAL mode):
DATABASE_URL=sqlite+aiosqlite:///./studybuddy.db

# ── File Storage & Vector Stores ─────────────────────────────────────────────
UPLOAD_DIR=./uploads
CHROMA_PERSIST_DIR=./chroma_db
FAISS_INDEX_DIR=./faiss_indexes
MAX_FILE_SIZE_MB=200
ASSIGNMENT_FILE_MAX_MB=50
NOTE_FILE_MAX_MB=50
PROFILE_PHOTO_MAX_MB=5

# ── CORS Origins ─────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8501,http://127.0.0.1:8501
RATE_LIMIT_PER_MINUTE=60

# ── Real Email Dispatch (SMTP) ───────────────────────────────────────────────
# Enter your SMTP credentials to send real OTP verification codes and student notifications.
# For Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=your-email@gmail.com
#   SMTP_PASS=your-16-char-app-password
#   SMTP_FROM=StudyBuddy <your-email@gmail.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=StudyBuddy <noreply@studybuddy.com>
APP_BASE_URL=http://localhost:3000

# ── Academic Defaults ────────────────────────────────────────────────────────
PERIOD_DURATION_MINUTES=45
LUNCH_DURATION_MINUTES=45
